# Local development only. Docker Compose enforces authentication for the API.
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
LOG_LEVEL=info

# Use private values in .env, never in Git.
POSTGRES_DB=commandement
POSTGRES_USER=commandement
POSTGRES_PASSWORD=
# Optional for direct Node commands; Docker Compose builds its own internal URL.
DATABASE_URL=

CORS_ORIGINS=http://localhost:4173
FAMILY_TIMEZONE=Europe/Paris

AUTH_ENABLED=true
AUTH_ISSUER_URL=http://localhost:8081/realms/commandement
# Separate audience from the browser client; ID tokens are not API access tokens.
AUTH_AUDIENCE=commandement-api
AUTH_JWKS_URL=http://keycloak:8080/realms/commandement/protocol/openid-connect/certs
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_DB_PASSWORD=

# Provisioning uses an explicit family UUID and exactly two Keycloak user UUIDs.
FAMILY_ID=
FAMILY_NAME=Example household
KEYCLOAK_USER_IDS=
