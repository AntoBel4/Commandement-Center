NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# PostgreSQL: never commit real values.
POSTGRES_DB=commandement
POSTGRES_USER=commandement
POSTGRES_PASSWORD=change-this-long-password

# Comma-separated browser origins, for example:
# CORS_ORIGINS=https://commandement.example.com
CORS_ORIGINS=http://localhost:4173

# OIDC / Keycloak. Keep disabled until the realm and client are configured.
AUTH_ENABLED=false
AUTH_ISSUER_URL=
AUTH_AUDIENCE=commandement-center
AUTH_JWKS_URL=
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=

# Shared secret used to authenticate inbound webhooks.
ALEXA_WEBHOOK_SECRET=

# Used only by the one-time family bootstrap command.
FAMILY_NAME=Ma famille
KEYCLOAK_USER_ID=
